# این فایل را به .env کپی کن و مقادیر واقعی را بگذار (یا همین‌ها را export کن).

# دیتابیس TimescaleDB
FX_DB_DSN=postgresql://fx:fx@localhost:5432/fxmacro

# کلید رایگان از finnhub.io — برای تقویم اقتصادی
FINNHUB_API_KEY=

# تلگرام (از BotFather) — برای هشدارها
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic — برای موتور لحن بانک مرکزی (cb_tone.py)
ANTHROPIC_API_KEY=
# مدل پیش‌فرض تحلیل لحن (اختیاری)
# CB_TONE_MODEL=claude-sonnet-4-5
